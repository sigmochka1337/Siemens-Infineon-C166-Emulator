// Короткий блок для требований.
#let req(id, description, priority: "MUST") = block(
  width: 100%,
  fill: light-gray,
  stroke: 0.7pt + border,
  radius: 3pt,
  inset: 9pt,
  above: 5pt,
  below: 7pt,
)[
