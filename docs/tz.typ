  #description
]

#let cli-command(command, description) = block(
  width: 100%,
  fill: rgb("#F8FAFC"),
  stroke: 0.7pt + rgb("#E2E8F0"),
  radius: 4pt,
  inset: (x: 10pt, y: 7pt),
  above: 4pt,
  below: 4pt,
