  #cli-command("ADD", [Сложение])
  #cli-command("ADDB", [Сложение (байтовое)])
  #cli-command("ADDC", [Сложение с учетом флага C от предыдущей операции])
  #cli-command("ADDCB", [Сложение с учетом флага C от предыдущей операции (байтовое)])
  #cli-command("SUB", [Вычитание])
  #cli-command("SUBB", [Вычитание (байтовое)])
  #cli-command("SUBC", [Вычитание с учетом флага C от предыдущей операции])
  #cli-command("SUBCB", [Вычитание с учетом флага C от предыдущей операции (байтовое)])
  #cli-command("MUL", [Умножение])
  #cli-command("MULU", [Беззнаковое умножение])
  #cli-command("DIV", [Деление])
  #cli-command("DIVL", [Деление (32 бит)])
  #cli-command("DIVU", [Беззнаковое деление])
  #cli-command("DIVLU", [Беззнаковое деление (32 бит)])
  #cli-command("CMP", [Сравнение операндов (изменяет только флаги)])
  #cli-command("CMPB", [Сравнение операндов (байтовое) (изменяет только флаги)])
  #cli-command("NEG", [Арифметическое отрицание])
])

=== 4. BitProcessor
Компонент, аналогичный ALU, который предоставляет операции с битами.
#info-box("Операции BitProcessor")[
  #cli-command("AND", [Побитовое И])
  #cli-command("OR", [Побитовое ИЛИ])
  #cli-command("XOR", [Побитовое исключающее ИЛИ])
  #cli-command("CPL", [Побитовое НЕ])
  #cli-command("SHL", [Сдвиг влево])
  #cli-command("SHR", [Сдвиг вправо])
  #cli-command("ASHR", [Арифметический сдвиг вправо (сохраняется знаковый бит)])
  #cli-command("ROL", [Циклический сдвиг влево])
  #cli-command("ROR", [Циклический сдвиг вправо])
]


=== 5. Stack + BranchUnit
Компонент, эмулирующий работу стека. Содержит в себе Stack Pointer (SP), механизмы контроля переполнения и опустошения стека (STKOV и STKUN), интерфейсы для реализации вызова функции (CALL) и возврата (RET). Ветвление реализуется с помощью условных вызовов подпрограмм.
#info-box("Операции Stack", [
  #cli-command("PUSH", [Уменьшает SP на 2 и записывает WORD на стек])
  #cli-command("POP", [Читает WORD со стека и увеличивает SP на 2])
  #cli-command("CALL", [Сохраняет адрес возврата на стеке и передает управление функции])
  #cli-command("RET", [Читает адрес возврата и передает управление по нему])
  #cli-command("RETS", [Читает адрес возврата и сегмент и передает управление по ним])
  #cli-command(
    "RETP",
    [Читает адрес возврата и сохраненный регистр и передает управление по нему, восстанавливая значение регистра],
  )
  #cli-command("STKOV", [Регистр для контроля переполнения стека])
  #cli-command("STKUN", [Регистр для контроля пустоты стека])
  #cli-command("CALLA", [Если выполняется условие, передать управление функции (абсолютный адрес)])
  #cli-command("CALLI", [Если выполняется условие, передать управление функции (адрес функции берется из регистра)])
  #cli-command("CALLR", [Безусловно передать управление функции (относительный адрес)])
  #cli-command("CALLS", [Безусловно передать управление функции из другого сегмента])
  #cli-command(
    "PCALL",
    [Передать управление функции, сохранив определенный регистр на стеке (восстановится после оператора RETP)],
  )
  #cli-command("JMPA", [Условный переход по абсолютному адресу])
  #cli-command("JMPI", [Условный переход по адресу из регистра])
  #cli-command("JMPR", [Условный переход по относительному адресу])
  #cli-command("JMPS", [Безусловный переход по абсолютному адресу с учетом сегмента])
  #cli-command("JB", [Условный переход, если установлен определённый бит])
  #cli-command("JNB", [Условный переход, если НЕ установлен определённый бит])
  #cli-command("JBC", [Условный переход, если установлен определённый бит (бит сбрасывается)])
  #cli-command("JNBS", [Условный переход, если НЕ установлен определённый бит (бит устанавливается)])
])

=== 6. Memory
Этот компонент должен предоставлять интерфейс для чтения и записи данных и учитывать механизмы DPP.

#info-box("Операции Memory", [
  #cli-command("read8", [Прочитать BYTE по адресу])
  #cli-command("read16", [Прочитать WORD по адресу])
  #cli-command("write8", [Записать BYTE по адресу])
  #cli-command("write16", [Записать WORD по адресу])
  #cli-command("LogicToPhysic", [Перевести 16-битный логический адрес в 24-битный физический, учитывая механизм DPP])
])

=== 7. MoveUnit
Компонент, который предоставляет интерфейс для всех вариаций операции MOV (копирование из одного места в другое).

#info-box("Операции MoveUnit", [
  #cli-command("MOV", [Скопировать значение правого операнда в левый (Оба операнда WORD)])
  #cli-command("MOVB", [Скопировать значение правого операнда в левый (Оба операнда BYTE)])
  #cli-command("MOVBS", [Скопировать значение правого операнда в левый (Из BYTE в WORD с сохранением бита знака)])
  #cli-command(
    "MOVBZ",
    [Скопировать значение правого операнда в левый (Из BYTE в WORD, старший байт результата зануляется)],
