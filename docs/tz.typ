  #v(4pt)
  #body
]

#let success-box(title, body) = block(
  width: 100%,
  fill: secondary-light,
  stroke: (left: 3pt + secondary, rest: 0.7pt + border),
  radius: 4pt,
  inset: 10pt,
  above: 6pt,
  below: 10pt,
)[
  #text(weight: "bold", fill: secondary)[#title]
  #v(4pt)
  #body
]

#let warning-box(title, body) = block(
  width: 100%,
  fill: warning-light,
  stroke: (left: 3pt + warning, rest: 0.7pt + border),
  radius: 4pt,
  inset: 10pt,
  above: 6pt,
  below: 10pt,
)[
  #text(weight: "bold", fill: warning)[#title]
  #v(4pt)
  #body
]

#let danger-box(title, body) = block(
  width: 100%,
  fill: danger-light,
  stroke: (left: 3pt + danger, rest: 0.7pt + border),
  radius: 4pt,
  inset: 10pt,
  above: 6pt,
  below: 10pt,
)[
  #text(weight: "bold", fill: danger)[#title]
  #v(4pt)
  #body
]

// Короткий блок для требований.
#let req(id, description, priority: "MUST") = block(
  width: 100%,
  fill: light-gray,
  stroke: 0.7pt + border,
  radius: 3pt,
  inset: 9pt,
  above: 5pt,
  below: 7pt,
)[
  #text(weight: "bold", fill: primary)[#id]
  #h(8pt)
  #text(weight: "bold")[#priority]
  #h(6pt)
  #description
]

#let cli-command(command, description) = block(
  width: 100%,
  fill: rgb("#F8FAFC"),
  stroke: 0.7pt + rgb("#E2E8F0"),
  radius: 4pt,
  inset: (x: 10pt, y: 7pt),
  above: 4pt,
  below: 4pt,
)[
  #grid(
    columns: (2.5cm, 1fr),
    gutter: 10pt,
    align: (left, left),
    [
      #text(weight: "bold", fill: rgb("#2563EB"))[#command]
    ],
    [
      #description
    ],
  )
]

#let code-block(code, language: "text") = block(
  width: 100%,
  fill: rgb("#0F172A"),
  radius: 6pt,
  inset: 12pt,
  above: 8pt,
  below: 12pt,
)[
  #text(
    font: "DejaVu Sans Mono",
    size: 9pt,
    fill: rgb("#E2E8F0"),
  )[
    #raw(code, lang: language)
  ]
]
