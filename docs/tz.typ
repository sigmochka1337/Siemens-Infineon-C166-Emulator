// -------------------------
// Цветовая схема
// -------------------------

#let primary = rgb("#2563EB")       // основной синий
#let primary-light = rgb("#EFF6FF") // светло-синий фон
#let secondary = rgb("#0F766E")     // зелёно-бирюзовый
#let secondary-light = rgb("#ECFDF5")
#let warning = rgb("#D97706")       // оранжевый
#let warning-light = rgb("#FFFBEB")
#let danger = rgb("#DC2626")        // красный
#let danger-light = rgb("#FEF2F2")
#let dark = rgb("#172033")
#let gray = rgb("#64748B")
#let light-gray = rgb("#F8FAFC")
#let border = rgb("#E2E8F0")

// -------------------------
// Настройка страницы
// -------------------------

#set page(
  paper: "a4",
  margin: (
    top: 2.2cm,
    bottom: 2.0cm,
    left: 2.3cm,
    right: 2.0cm,
  ),
  header: context {
    if counter(page).get().first() > 1 {
      align(right)[
        #text(size: 8.5pt, fill: gray)[ТЕХНИЧЕСКОЕ ЗАДАНИЕ]
      ]
    }
  },
  footer: context {
    align(center)[
      #text(size: 8.5pt, fill: gray)[
        #counter(page).display()
      ]
    ]
  },
)

#set text(
  size: 10.5pt,
  fill: dark,
)

#set par(
  justify: false,
  leading: 0.65em,
)

#set heading(numbering: "1.1")

// -------------------------
// Заголовки
// -------------------------

#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  block(
    width: 100%,
    below: 12pt,
  )[
    #text(size: 19pt, weight: "bold", fill: primary)[
      #it.body
    ]
  ]
}

#show heading.where(level: 2): it => {
  block(
    width: 100%,
    above: 12pt,
    below: 7pt,
  )[
    #text(size: 13.5pt, weight: "bold", fill: dark)[
      #it.body
    ]
  ]
}

#show heading.where(level: 3): it => {
  block(
    width: 100%,
    above: 8pt,
    below: 5pt,
  )[
    #text(size: 11.5pt, weight: "bold", fill: primary)[
      #it.body
    ]
  ]
}

// -------------------------
// Универсальные блоки
// -------------------------

#let info-box(title, body) = block(
  width: 100%,
  fill: primary-light,
  stroke: (left: 3pt + primary, rest: 0.7pt + border),
  radius: 4pt,
  inset: 10pt,
  above: 6pt,
  below: 10pt,
)[
